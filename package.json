{
  "name": "meracast",
  "version": "1.0.0",
  "private": true,
  "description": "MeraCast — Know before the clouds do. A cinematic weather experience by MeraVex.",
  "scripts": {
    "fonts": "node scripts/sync-fonts.mjs",
    "build:sw": "node scripts/generate-sw.mjs",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts && npm run build:sw",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-font-manifest.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@tanstack/query-sync-storage-persister": "^5.62.7",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-persist-client": "^5.62.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
